{
  "name": "retailer-web-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generateBuildInfo.cjs",
    "prebuild:uat": "node scripts/generateBuildInfo.cjs",

    "dev": "vite --mode development",
    "dev:uat": "vite --mode uat",
    "dev:prod": "vite --mode production",

    "clean" : "rimraf dist",

    "build:dev:": "npm run clean && tsc -b && vite build --mode development && npm run copy-webxml",
    "build:uat": "npm run clean && tsc -b && vite build --mode uat && npm run copy-webxml",
    "build": "npm run clean && tsc -b && vite build --mode production && npm run copy-webxml",

    "war:dev": "npm run build:dev && node scripts/createWar.cjs",
    "war:uat": "npm run build:uat && node scripts/createWar.cjs",
    "war": "npm run build && node scripts/createWar.cjs",

    "copy-webxml": "node scripts/copyWebXml.cjs",

    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 1",

    "preview": "vite preview",
    "preview:uat": "vite preview --mode uat",
    "preview:dev": "vite preview --mode development",
    
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint-staged": "lint-staged",
    "precommit": "npm run lint-staged"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/carousel": "^7.17.8",
    "@mantine/charts": "^7.17.8",
    "@mantine/code-highlight": "^7.17.8",
    "@mantine/core": "^7.17.8",
    "@mantine/dates": "^7.17.8",
    "@mantine/dropzone": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@mantine/nprogress": "^7.17.8",
    "@mantine/spotlight": "^7.17.8",
    "@mantine/tiptap": "^7.17.8",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.1.1",
    "@mui/system": "^7.1.0",
    "@mui/x-date-pickers": "^8.5.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@reduxjs/toolkit": "^2.2.1",
    "@stomp/stompjs": "^7.3.0",
    "@tabler/icons-react": "^2.42.0",
    "@tanstack/react-query": "^5.24.1",
    "@tiptap/extension-link": "^2.14.0",
    "@tiptap/pm": "^2.14.0",
    "@tiptap/react": "^2.14.0",
    "@tiptap/starter-kit": "^2.14.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react-redux": "^7.1.34",
    "@types/redux-persist": "^4.0.0",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "dayjs": "^1.11.13",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "formik": "^2.4.5",
    "graphify": "^1.0.0",
    "i18next": "^23.10.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "lodash.throttle": "^4.1.1",
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.12.2",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^14.0.5",
    "react-otp-input": "^3.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.22.2",
    "react-scripts": "5.0.1",
    "react-to-print": "^3.1.1",
    "react-toastify": "^10.0.4",
    "recharts": "^2.15.4",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^2.2.1",
    "usehooks-ts": "^3.1.1",
    "xlsx": "^0.18.5",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^18.6.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^20.19.9",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "commitlint": "^18.6.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "rimraf": "^6.1.3",
    "tailwind-clip-path": "^1.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^5.1.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettier-format && npm run lint"
    }
  }
}
